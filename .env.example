# 로컬 개발 전용 테스트 값. 실제 서비스 비밀번호를 넣지 말 것.
MYSQL_ROOT_PASSWORD=InU1XZ36wr6do2uY
MYSQL_DATABASE=terminal_ops
MYSQL_USER=terminal_ops
MYSQL_PASSWORD=RkPBRxf75kRA2Q6P
MYSQL_PORT=3306
REDIS_PORT=6379

MYSQL_TEST_DATABASE=terminal_ops_test
API_PORT=3000

# Day 2: 가상 업체 서버, Redis(BullMQ), 실행 모드
PARTNERS_URL=http://127.0.0.1:4010
PARTNERS_PORT=4010
# Day 4: 단말기 시뮬레이터 관리 포트(테스트는 4021)
DEVICE_SIM_PORT=4020
REDIS_HOST=127.0.0.1
RUN_WORKERS=1
RUN_SCHEDULERS=1
SWEEP_INTERVAL_MS=30000
RELAY_INTERVAL_MS=2000
# Day 4 주기 작업(ms) — decisions/0028
ACTIVE_REBUILD_INTERVAL_MS=60000
# 접속 상태 — decisions/0029
# 하트비트 쓰기 경로: redis(운영) / mysql(실험 0008 비교용) — decisions/0027
# 경고: mysql이면 Redis lastSeen·firmware가 비어 오프라인 판정·스냅샷·접속 상태 조회가 깨진다. NODE_ENV=production에서는 서버가 뜨지 않는다
HEARTBEAT_WRITE_MODE=redis
HEARTBEAT_OFFLINE_AFTER_MS=90000
OFFLINE_DETECT_INTERVAL_MS=10000
CONNECTIVITY_SNAPSHOT_INTERVAL_MS=60000
# 펌웨어 배포 판단 주기 — decisions/0031
ROLLOUT_CONTROL_INTERVAL_MS=5000
# 한 번 판정에서 오프라인(또는 온라인)이 이보다 많으면 알림을 묶음 한 건으로
CONNECTIVITY_BULK_EVENT_THRESHOLD=50
BUNGAE_RATE_PER_SEC=10
NEURIMBO_RATE_PER_SEC=5
TOKTOK_CHANNEL=ops
# 톡톡메신저 첨부 크기 상한(바이트, 최대 16777215) — 주간 리포트가 이보다 크면 올리기 전에 멈춘다(decisions/0035)
TOKTOK_MAX_FILE_BYTES=5242880
# 박스 스캔 처리 중 잠금 TTL(ms) — decisions/0020
SCAN_LOCK_TTL_MS=30000
# A/S 교체 단말기 예약(Redis) TTL(ms) — decisions/0026
REPLACEMENT_LOCK_TTL_MS=30000

# Day 5: 브릿지VAN 등록 대조(F9) — decisions/0033
BRIDGEVAN_PAGE_SIZE=500
VAN_RUN_HEARTBEAT_STALE_MS=300000
VAN_REVERIFY_CONCURRENCY=8
# 하트비트 최소 간격. STALE_MS ≥ 이 값 + 5 × PARTNER_TIMEOUT_MS + 7500 + 60000(Retry-After 상한) 이어야 서버가 뜬다
VAN_HEARTBEAT_INTERVAL_MS=30000
# 안전장치: 후보 > max(ABS_CAP, max(수집, 운영 중) × MAX_PCT%)이거나, 수집이 마지막 완료 실행의 MIN_PCT% 미만·수집 0건인데 운영 중 있음이면 FAILED
# (MIN_PCT 0 = 수집 급감 검사 끔. 운영자가 확인한 실행은 POST 본문 { "acknowledgeDrop": true }로 그 실행만 건너뜀)
VAN_CANDIDATE_ABS_CAP=5000
VAN_CANDIDATE_MAX_PCT=20
VAN_FETCH_MIN_PCT=50

# 이상 단말기 찾기(F4) 기준일 — decisions/0034
ANOMALY_DELIVERED_DAYS=7
ANOMALY_RETURN_STALLED_DAYS=14
ANOMALY_SHIPPED_DAYS=10
ANOMALY_ALLOCATED_DAYS=3
ANOMALY_OFFLINE_DAYS=3
ANOMALY_BULK_EVENT_THRESHOLD=20
# 주기 작업 cron(분 시 일 월 요일 다섯 칸, 시간대 Asia/Seoul. @daily·초 칸·네 칸은 시작할 때 거절) — decisions/0035
ANOMALY_SCAN_CRON="0 2 * * *"
VAN_RECONCILE_CRON="0 3 * * *"
# 주간 운영 리포트(F11): 매주 월요일 09:00 KST에 지난주 xlsx를 톡톡메신저에 첨부로 보낸다
WEEKLY_REPORT_CRON="0 9 * * 1"

# Day 7: QUEUED outbox 복구 sweep — decisions/0042 (주기, 그리고 QUEUED로 이만큼 지났는데 큐에 job이 없으면 같은 jobId로 다시 넣는다)
OUTBOX_REQUEUE_INTERVAL_MS=60000
OUTBOX_REQUEUE_AFTER_MS=60000
# 처음 화면 대시보드 집계 Redis 캐시 TTL(ms) — decisions/0044 (화면 문구는 "기본 30초"라 바꾸면 화면 안내와 어긋난다)
DASHBOARD_CACHE_TTL_MS=30000

# 보강 2: 로그인·권한 — decisions/0050~0056 (값은 모두 로컬 시연 전용 테스트 값)
# 단말기(시뮬레이터)가 X-Device-Key로 보내는 공유 키(16자 이상). api와 device-sim이 같은 값을 읽는다
DEVICE_API_KEY=demo-device-NTLP5MxPGtlzOw4KTaNDvFy209xRlty7
# 로그인 세션 유휴 만료(ms, 기본 8시간), 쿠키 Secure(https 뒤에서만 1)
SESSION_IDLE_TTL_MS=28800000
SESSION_COOKIE_SECURE=0
# 같은 아이디로 로그인 실패 N번이면 LOGIN_LOCK_MS 동안 막는다
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MS=900000
